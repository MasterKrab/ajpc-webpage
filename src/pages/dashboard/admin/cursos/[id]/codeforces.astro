---
import DashboardLayout from '@layouts/DashboardLayout.astro'
import CourseDashboardHeader from '@components/admin/dashboard/CourseDashboardHeader.astro'
import CourseCodeforcesTab from '@components/admin/dashboard/CourseCodeforcesTab.svelte'
import { isAdmin } from '@lib/auth'
import { db } from '@db/index'
import { courses, enrollments, codeforcesContests } from '@db/schema'
import { eq, count } from 'drizzle-orm'

const user = Astro.locals.user
if (!user || !isAdmin(user)) return Astro.redirect('/login')

const { id } = Astro.params
if (!id) return Astro.redirect('/dashboard/admin/courses')

const [courseData] = await db.select().from(courses).where(eq(courses.id, id))
if (!courseData) return Astro.redirect('/dashboard/admin/courses')

// Fetch total count for header
const [totalRes] = await db
  .select({ value: count() })
  .from(enrollments)
  .where(eq(enrollments.courseId, id))

const contestsData = await db
  .select({
    id: codeforcesContests.id,
    name: codeforcesContests.name,
    type: codeforcesContests.type,
    startTimeSeconds: codeforcesContests.startTimeSeconds,
    durationSeconds: codeforcesContests.durationSeconds,
    countedForGlobal: codeforcesContests.countedForGlobal,
  })
  .from(codeforcesContests)
  .where(eq(codeforcesContests.courseId, id))
---

<DashboardLayout
  metadata={{
    title: `Codeforces — ${courseData.name}`,
    description: 'Gestión de integración con Codeforces',
  }}
>
  <CourseDashboardHeader
    course={courseData}
    activeTab="codeforces"
    enrollmentTotal={totalRes.value}
  />

  <main>
    <CourseCodeforcesTab
      client:load
      courseId={id}
      codeforcesGroupId={courseData.codeforcesGroupId}
      initialContests={contestsData as any}
    />
  </main>
</DashboardLayout>
