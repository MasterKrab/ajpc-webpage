---
import DashboardLayout from '@layouts/DashboardLayout.astro'
import RankingManager from '@components/dashboard/RankingManager.svelte'
import { isAdmin } from '@lib/auth'
import { db } from '@db/index'
import { courses, enrollments } from '@db/schema'
import { eq, inArray } from 'drizzle-orm'

const user = Astro.locals.user
if (!user) return Astro.redirect('/login')

let availableCourses = []

if (isAdmin(user)) {
  availableCourses = await db
    .select({ id: courses.id, name: courses.name })
    .from(courses)
} else {
  // Only courses where the user is enrolled
  const userEnrollments = await db
    .select({ courseId: enrollments.courseId })
    .from(enrollments)
    .where(eq(enrollments.userId, user.id))

  const courseIds = userEnrollments.map(({ courseId }) => courseId)

  if (courseIds.length > 0) {
    availableCourses = await db
      .select({ id: courses.id, name: courses.name })
      .from(courses)
      .where(inArray(courses.id, courseIds))
  }
}

const courseId =
  Astro.url.searchParams.get('courseId') || availableCourses[0]?.id
---

<DashboardLayout
  metadata={{
    title: 'Ranking AJPC',
    description: 'Ranking de los cursos AJPC',
  }}
>
  <div class="ranking-page">
    <header class="ranking-page__header">
      <h1 class="ranking-page__title">Ranking AJPC</h1>
      <p class="ranking-page__desc">
        Puntajes acumulados en base a los concursos de Codeforces seleccionados.
      </p>
    </header>

    <RankingManager
      client:load
      courses={availableCourses}
      initialCourseId={courseId}
      isAdmin={isAdmin(user)}
    />
  </div>
</DashboardLayout>

<style>
  .ranking-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .ranking-page__title {
    font-size: 2rem;
    margin: 0 0 0.5rem;
  }
  .ranking-page__desc {
    color: var(--text-color-secondary);
    margin: 0;
  }
</style>
